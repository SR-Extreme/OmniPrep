# =============================================================================
# OmniPrep — environment variable template
# Copy values into the correct app file
# =============================================================================
#
# Infrastructure: Neon PostgreSQL + Upstash Redis (no Docker)
# - Neon:  https://neon.tech  → connection string for DATABASE_URL
# - Upstash: https://upstash.com → TLS Redis URL for REDIS_URL (rediss://)
#
# =============================================================================

# --- Backend (apps/backend/.env) ---
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
REDIS_URL=rediss://default:TOKEN@HOST:6379

# JWT_ACCESS_SECRET=change-me-use-long-random-string
# JWT_REFRESH_SECRET=change-me-use-another-long-random-string
# JWT_ACCESS_EXPIRY=15m
# JWT_REFRESH_EXPIRY=7d

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# JUDGE0_API_KEY=
# JUDGE0_BASE_URL=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# FRONTEND_URL=http://localhost:3000

# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_SIX_MONTHS=price_...
# STRIPE_PRICE_YEARLY=price_...

# --- Frontend (apps/frontend/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# EMAILJS_PUBLIC_KEY=
