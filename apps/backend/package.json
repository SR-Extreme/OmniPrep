{
    "name": "backend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "OmniPrep API server",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "seed:generate": "tsx prisma/seeds/generate-json-files.ts",
        "seed:validate": "tsx prisma/seeds/validate-specs.ts",
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@esbuild/win32-x64": "^0.28.0",
        "@prisma/client": "^6.2.0",
        "bcrypt": "^5.1.1",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.0",
        "jsonwebtoken": "^9.0.2",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^20.14.0",
        "prisma": "^6.2.0",
        "tsx": "^4.19.0",
        "typescript": "^5.5.0"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    }
