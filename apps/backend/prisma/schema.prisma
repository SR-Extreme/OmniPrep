generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CANDIDATE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProgrammingLanguage {
  CPP
  JAVA
  PYTHON
}

enum SubmissionStatus {
  PENDING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
  INTERNAL_ERROR
}

enum BehavioralPhaseType {
  INTRODUCTION
  ICE_BREAKER
  RESUME_DEEP_DIVE
  CORE_BEHAVIORAL
  COMPANY_VALUES
  CANDIDATE_QUESTIONS
  WRAP_UP
}

enum BehavioralSessionStatus {
  IN_PROGRESS
  COMPLETED
}

enum MockInterviewStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_FINAL_SUBMIT
  COMPLETED
}

enum MockInterviewSection {
  DSA
  SYSTEM_DESIGN
  BEHAVIORAL
}

enum SubscriptionPlan {
  MONTHLY
  SIX_MONTHS
  YEARLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  FAILED
  REFUNDED
}

enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
}

model User {
  id                    String                   @id @default(cuid())
  email                 String                   @unique
  passwordHash          String
  role                   Role                     @default(CANDIDATE)
  name                   String
  image                  String?
  phoneNo                String?
  isPremium              Boolean                  @default(false)
  premiumFrom            DateTime?
  premiumTill            DateTime?
  averageInterviewScore  Float?
  recentLogin            DateTime?
  createdAt              DateTime                 @default(now())
  refreshTokens          RefreshToken[]
  otpChallenges          OtpChallenge[]
  subscriptions          Subscription[]
  submissions            Submission[]
  dsaEvaluations         DsaEvaluation[]
  systemDesignSubmissions SystemDesignSubmission[]
  systemDesignEvaluations SystemDesignEvaluation[]
  behavioralSessions     BehavioralSession[]
  behavioralEvaluations  BehavioralEvaluation[]
  mockInterviews          MockInterview[]

  @@index([isPremium])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model OtpChallenge {
  id                 String     @id @default(cuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose            OtpPurpose
  otpHash            String
  challengeTokenHash String     @unique
  expiresAt          DateTime
  createdAt          DateTime   @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

model Subscription {
  id                      String             @id @default(cuid())
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                    SubscriptionPlan
  amount                  Int
  currency                String             @default("INR")
  status                  SubscriptionStatus @default(PENDING)
  stripeSessionId         String             @unique
  stripePaymentIntentId   String?            @unique
  startsAt                DateTime
  expiresAt               DateTime
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([userId])
  @@index([status])
  @@index([plan])
  @@index([createdAt])
  @@index([userId, status])
  @@index([expiresAt])
}

model Problem {
  id                    String                    @id @default(cuid())
  slug                  String                    @unique
  title                 String
  description           String                    @db.Text
  inputFormat           String?                   @db.Text
  outputFormat          String?                   @db.Text
  constraints           String?                   @db.Text
  examples              Json?
  difficulty            Difficulty
  topics                String[]                  @default([])
  timeLimitMs           Int                       @default(2000)
  memoryLimitKb         Int                       @default(256000)
  starterCode           Json?
  solutionCode          Json?
  hints                 String[]                  @default([])
  acceptanceRate        Float?
  isPublished           Boolean                   @default(false)
  publishedAt           DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  testCases             TestCase[]
  submissions           Submission[]
  dsaEvaluations        DsaEvaluation[]
  mockInterviewDsaSlots MockInterviewDsaProblem[]

  @@index([difficulty])
  @@index([isPublished])
  @@index([publishedAt])
}

model TestCase {
  id             String   @id @default(cuid())
  problemId      String
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input          String   @db.Text
  expectedOutput String   @db.Text
  explanation    String?  @db.Text
  isHidden       Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([problemId])
}

model Submission {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId       String
  problem         Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language        ProgrammingLanguage
  sourceCode      String           @db.Text
  status          SubmissionStatus @default(PENDING)
  passedTests     Int              @default(0)
  totalTests      Int              @default(0)
  testResults     Json?
  judge0Token     String?
  stdout          String?          @db.Text
  stderr          String?          @db.Text
  compileOutput   String?          @db.Text
  executionTimeMs Float?
  memoryKb        Int?
  isSampleRun     Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  dsaEvaluation   DsaEvaluation?

  @@index([userId])
  @@index([problemId])
  @@index([userId, problemId])
  @@index([createdAt])
}

model DsaEvaluation {
  id                 String     @id @default(cuid())
  submissionId       String     @unique
  submission         Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId          String
  problem            Problem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  overallScore       Int
  correctnessScore   Int
  efficiencyScore    Int
  codeQualityScore   Int
  explanationScore   Int
  complexityAnalysis Json
  followUpQuestions  Json
  feedback           String     @db.Text
  suggestions        Json
  model              String
  tokensUsed         Int
  createdAt          DateTime   @default(now())

  @@index([userId])
  @@index([problemId])
  @@index([userId, problemId])
  @@map("DSAEvaluation")
}

model SystemDesignQuestion {
  id                       String                      @id @default(cuid())
  slug                     String                      @unique
  title                    String
  description              String                      @db.Text
  requirements             Json
  deliverables             Json
  constraints              String[]                    @default([])
  scaleFactors             String[]                    @default([])
  difficulty               Difficulty
  topics                   String[]                    @default([])
  hints                    String[]                    @default([])
  evaluationMetrics        Json
  isPublished              Boolean                     @default(false)
  publishedAt              DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  submissions              SystemDesignSubmission[]
  evaluations              SystemDesignEvaluation[]
  mockInterviewAssignments MockInterviewSystemDesign[]

  @@index([difficulty])
  @@index([isPublished])
  @@index([publishedAt])
}

model SystemDesignSubmission {
  id                String                    @id @default(cuid())
  userId            String
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId        String
  question          SystemDesignQuestion      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  textAnswer        String?                   @db.Text
  diagramUrl        String?
  followUpQuestions Json?
  followUpAnswers   Json?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  evaluation        SystemDesignEvaluation?

  @@index([userId])
  @@index([questionId])
  @@index([userId, questionId])
  @@index([createdAt])
}

model SystemDesignEvaluation {
  id                String                 @id @default(cuid())
  submissionId      String                 @unique
  submission        SystemDesignSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId            String
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId        String
  question          SystemDesignQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  overallScore      Int
  metricScores      Json
  strengths         Json
  weaknesses        Json
  followUpQuestions Json
  feedback          String                 @db.Text
  suggestions       Json
  model             String
  tokensUsed        Int
  createdAt         DateTime               @default(now())

  @@index([userId])
  @@index([questionId])
  @@index([userId, questionId])
}

model BehavioralQuestion {
  id                       String                    @id @default(cuid())
  slug                     String                    @unique
  title                    String
  description              String                    @db.Text
  companyName              String
  roleName                 String
  difficulty               Difficulty
  phases                   Json
  isPublished              Boolean                   @default(false)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  sessions                 BehavioralSession[]
  evaluations              BehavioralEvaluation[]
  mockInterviewAssignments MockInterviewBehavioral[]

  @@index([companyName])
  @@index([roleName])
  @@index([companyName, roleName])
  @@index([difficulty])
  @@index([isPublished])
}

model BehavioralSession {
  id                      String                  @id @default(cuid())
  userId                  String
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId              String
  question                BehavioralQuestion      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  resumeUrl               String
  resumeFileName          String
  resumeMimeType          String
  resumeText              String                  @db.Text
  currentPhaseIndex       Int                     @default(0)
  status                  BehavioralSessionStatus @default(IN_PROGRESS)
  completedAt             DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  turns                   BehavioralTurn[]
  evaluation              BehavioralEvaluation?
  mockInterviewAssignment MockInterviewBehavioral?

  @@index([userId])
  @@index([questionId])
  @@index([status])
  @@index([userId, questionId])
  @@index([createdAt])
}

model BehavioralTurn {
  id                   String              @id @default(cuid())
  sessionId            String
  session              BehavioralSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  phaseType            BehavioralPhaseType
  orderIndex           Int
  questionIndexInPhase Int
  questionText         String              @db.Text
  candidateAnswerText  String?             @db.Text
  interviewerReplyText String?             @db.Text
  isFollowUp           Boolean             @default(false)
  createdAt            DateTime            @default(now())
  answeredAt           DateTime?

  @@index([sessionId])
  @@index([phaseType])
  @@index([sessionId, phaseType])
  @@unique([sessionId, orderIndex])
  @@unique([sessionId, phaseType, questionIndexInPhase])
}

model BehavioralEvaluation {
  id                String             @id @default(cuid())
  sessionId         String             @unique
  session           BehavioralSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId        String
  question          BehavioralQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  evaluationMetrics Json
  strongestAnswer   Json
  weakestAnswer     Json
  strengths         Json
  weaknesses        Json
  suggestions       Json
  summary           String             @db.Text
  model             String
  tokensUsed        Int
  createdAt         DateTime           @default(now())

  @@index([userId])
  @@index([questionId])
  @@index([userId, questionId])
}

model MockInterview {
  id                      String                    @id @default(cuid())
  userId                  String
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                  MockInterviewStatus       @default(NOT_STARTED)
  currentSection          MockInterviewSection      @default(DSA)
  startTime               DateTime?
  dsaStartedAt            DateTime?
  dsaSubmittedAt          DateTime?
  systemDesignStartedAt   DateTime?
  systemDesignSubmittedAt DateTime?
  behavioralStartedAt     DateTime?
  behavioralSubmittedAt   DateTime?
  finalizedAt             DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  dsaProblems             MockInterviewDsaProblem[]
  systemDesign            MockInterviewSystemDesign?
  behavioral              MockInterviewBehavioral?
  studyPlan               MockInterviewStudyPlan?

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([createdAt])
}

model MockInterviewDsaProblem {
  id              String        @id @default(cuid())
  mockInterviewId String
  mockInterview   MockInterview @relation(fields: [mockInterviewId], references: [id], onDelete: Cascade)
  problemId       String
  problem         Problem       @relation(fields: [problemId], references: [id], onDelete: Restrict)
  slotIndex       Int
  submissionId    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([mockInterviewId, slotIndex])
  @@unique([mockInterviewId, problemId])
  @@index([mockInterviewId])
  @@index([problemId])
}

model MockInterviewSystemDesign {
  id              String               @id @default(cuid())
  mockInterviewId String               @unique
  mockInterview   MockInterview        @relation(fields: [mockInterviewId], references: [id], onDelete: Cascade)
  questionId      String
  question        SystemDesignQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  submissionId    String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([questionId])
}

model MockInterviewBehavioral {
  id              String              @id @default(cuid())
  mockInterviewId String              @unique
  mockInterview   MockInterview       @relation(fields: [mockInterviewId], references: [id], onDelete: Cascade)
  roleName        String?
  questionId      String?
  question        BehavioralQuestion? @relation(fields: [questionId], references: [id], onDelete: Restrict)
  sessionId       String?             @unique
  session         BehavioralSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([questionId])
}

model MockInterviewStudyPlan {
  id                String        @id @default(cuid())
  mockInterviewId   String        @unique
  mockInterview     MockInterview @relation(fields: [mockInterviewId], references: [id], onDelete: Cascade)
  days              Json
  summary           String        @db.Text
  completedTaskKeys Json          @default("[]")
  completionPercent Int           @default(0)
  completedAt       DateTime?
  model             String
  tokensUsed        Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([mockInterviewId])
  @@index([completionPercent])
}